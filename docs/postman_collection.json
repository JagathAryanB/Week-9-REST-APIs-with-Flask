                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.status === 'success' && jsonData.data) {",
                  "    if (jsonData.data.access_token) pm.collectionVariables.set('access_token', jsonData.data.access_token);",
                  "    if (jsonData.data.refresh_token) pm.collectionVariables.set('refresh_token', jsonData.data.refresh_token);",
